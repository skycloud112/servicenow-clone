{
  "name": "servicenow-clone",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "ts": "turbo run ts",
    "format": "prettier --write .",
    "test": "TZ=UTC turbo test -- --bail=1",
    "admin:tenant1": "NEXT_PUBLIC_TENANT=tenant1 turbo run dev --filter=admin",
    "admin:tenant2": "NEXT_PUBLIC_TENANT=tenant2 turbo run dev --filter=admin",
    "user:tenant1": "NEXT_PUBLIC_TENANT=tenant1 turbo run dev --filter=user",
    "user:tenant2": "NEXT_PUBLIC_TENANT=tenant2 turbo run dev --filter=user",
    "storybook:ui": "pnpm -F @repo/ui storybook"
  },
  "devDependencies": {
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
